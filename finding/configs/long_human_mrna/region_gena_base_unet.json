{
  "seed": 42,
  "model": {
    "family": "unet",
    "backbone_kind": "gena",
    "backbone_path": "AIRI-Institute/gena-lm-bert-base-lastln-t2t",
    "tokenizer_path": "AIRI-Institute/gena-lm-bert-base-lastln-t2t",
    "trust_remote_code": true,
    "checkpoint_path": null,
    "allow_unsafe_torch_load_with_torch_lt_2_6": true,
    "vocab_size": null,
    "unet_cycles": 1,
    "unet_chunk_size": 8192
  },
  "train_dataset": {
    "path": "AIRI-Institute/genatator-gene-finding-dataset",
    "split": "train",
    "genomes": [
      "hg38"
    ],
    "chromosomes": [],
    "overlap": 0.5,
    "target_group": "mrna",
    "max_bpe_tokens": 512,
    "average_bpe_token_length": 9.0
  },
  "eval_dataset": {
    "path": "AIRI-Institute/genatator-gene-finding-dataset",
    "split": "validation",
    "genomes": [
      "hg38"
    ],
    "chromosomes": [],
    "overlap": 0.5,
    "target_group": "primary",
    "max_bpe_tokens": 512,
    "average_bpe_token_length": 9.0
  },
  "true_gff": "datasets/chr20.gff",
  "training": {
    "output_dir": "runs_massive/finding/long_human_mrna/region_gena_base_unet",
    "custom_prefix": "",
    "overwrite_output_dir": false,
    "max_steps": 500000,
    "per_device_train_batch_size": 1,
    "per_device_eval_batch_size": 1,
    "gradient_accumulation_steps": 1,
